{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": "./",
    "allowJs": true,
    "types": ["node", "jest", "supertest"],
    "noEmit": true
  },
  "include": [
    "server.ts",
    "src/**/*",
    "electron/**/*",
    "tests/**/*",
    "scratch/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "dist",
    "dist-electron",
    "electron/dist"
  ]
}
