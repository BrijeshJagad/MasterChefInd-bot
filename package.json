    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "electron": "^44.10.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
