{
  "name": "bot",
  "version": "2.0.0",
  "description": "",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npx next build frontend --webpack",
    "start": "tsx server.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit && tsc --project frontend/tsconfig.json --noEmit",
    "typecheck:root": "tsc --noEmit",
    "typecheck:frontend": "tsc --project frontend/tsconfig.json --noEmit",
    "build:server": "tsc -p tsconfig.json --noEmit false",
    "build:electron": "tsc -p electron/tsconfig.json",
    "desktop": "npm run build:electron && npx electron electron/dist/main.js",
    "android:sync": "npx cap sync",
    "metrics:up": "docker compose -f monitoring/docker-compose.monitoring.yml up -d",
    "metrics:down": "docker compose -f monitoring/docker-compose.monitoring.yml down"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.32.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "axios": "^1.21.0",
    "body-parser": "^2.4.0",
    "canvas": "^3.2.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "next": "^16.4.5",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^2.3.0",
    "openai": "^7.53.0",
    "pdf2json": "^4.1.1",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
